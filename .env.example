# Local development only. Copy to .env and fill in your local MySQL details.
# Do not upload .env to Spaceship or commit it to source control.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-local-development-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# These are your LOCAL MySQL credentials, not your Spaceship account login.
DB_NAME=your_local_database_name
DB_USER=your_local_database_user
DB_PASSWORD=your_local_database_password
DB_HOST=localhost
DB_PORT=3306
