# Local development only. Copy to .env and fill in your local MySQL details.
# Do not upload .env to Spaceship or commit it to source control.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-local-development-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# These are your LOCAL MySQL credentials, not your Spaceship account login.
DB_NAME=your_local_database_name
DB_USER=your_local_database_user
DB_PASSWORD=your_local_database_password
DB_HOST=localhost
DB_PORT=3306

# Order-status email sender. For Gmail SMTP, use a Google App Password
# (with 2-Step Verification enabled), not your normal Gmail password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=extrauserdata@gmail.com
EMAIL_HOST_PASSWORD=wmkh nehn dnji pgkc
DEFAULT_FROM_EMAIL=extrauserdata@gmail.com
NOREPLY_EMAIL=noreply@jiovendor.com
ADMIN_EMAIL=extrauserdata@gmail.com
